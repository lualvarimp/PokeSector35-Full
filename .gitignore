# ============================================================
# .gitignore — raíz del proyecto pokesector-fullstack
# ============================================================

# Dependencias
node_modules/

# Variables de entorno (nunca subir credenciales)
.env
.env.*
!.env.example

# Datos de prueba (nunca subir a GitHub)
migrate_slot_cascade.sql

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*

# Build outputs
dist/
build/
.next/
out/

# Vite / cache
.cache/
.parcel-cache/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
*.tsbuildinfo

# Docker volumes (datos de PostgreSQL)
db/data/

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# VS Code
.vscode/
!.vscode/extensions.json

# Tests
coverage/
.nyc_output/

# Yarn / pnpm
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*
