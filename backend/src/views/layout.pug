doctype html
html(lang='es')
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    meta(name='description' content='Panel de administración PokéSector 35')
    title= title || 'PokéSector Admin - Dashboard'
    link(rel='preconnect' href='https://fonts.googleapis.com')
    link(rel='preconnect' href='https://fonts.gstatic.com' crossorigin)
    link(href='https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap' rel='stylesheet')
    link(rel='stylesheet' href='/pokesector35/css/layout.css')
    link(rel='stylesheet' href='/pokesector35/css/dashboard.css')
    link(rel='stylesheet' href='/pokesector35/css/login.css')
    link(rel='stylesheet' href='/pokesector35/css/users-detail.css')
    link(rel='stylesheet' href='/pokesector35/css/ranking.css')
    link(rel='stylesheet' href='/pokesector35/css/pokedex.css')
    link(rel='stylesheet' href='/pokesector35/css/slots.css')
    link(rel='stylesheet' href='/pokesector35/css/users.css')
  
  body
    nav.navbar
      div
        .logo-placeholder
          a(href='/pokesector35/') POKÉSECTOR ADMIN
        
        button#menuToggle
          span
          span
          span
        
        ul#navMenu
          //- Menú Admin
          li#adminMenu(style='display: none;')
            a(href='/pokesector35/admin/dashboard') Dashboard
          li#adminMenu(style='display: none;')
            a(href='/pokesector35/admin/users') Usuarios
          li#adminMenu(style='display: none;')
            a(href='/pokesector35/admin/ranking') Ranking
          li#adminMenu(style='display: none;')
            a(href='#' onclick='performLogout(event)') Logout
        
        .theme-toggle
          input#themeSwitch(type='checkbox')
          label(for='themeSwitch')

    //- Main content
    main.main-content
      block content

    //- Footer reutilizable
    footer.login-footer
      p &copy; 2026 PokéSector 35 | Desarrollado por Luis Alonso

    //- Scripts
    script(src='/pokesector35/js/layout.js')
    block scripts
