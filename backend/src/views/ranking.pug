extends layout

block content
  .ranking-container
    //- Encabezado
    .ranking-header
      h1.ranking-title Ranking Global

    //- Filtros
    .ranking-filters
      .filter-group
        label(for='difficultyFilter') Filtrar por Dificultad:
        select#difficultyFilter.filter-select
          option(value='todos') Todas
          option(value='facil') Fácil
          option(value='normal') Normal
          option(value='dificil') Difícil
          option(value='infernal') Infernal

      .filter-group
        label(for='letterFilter') Filtrar por letra:
        select#letterFilter.filter-select
          option(value='all') Todas
          option(value='A') A
          option(value='B') B
          option(value='C') C
          option(value='D') D
          option(value='E') E
          option(value='F') F
          option(value='G') G
          option(value='H') H
          option(value='I') I
          option(value='J') J
          option(value='K') K
          option(value='L') L
          option(value='M') M
          option(value='N') N
          option(value='O') O
          option(value='P') P
          option(value='Q') Q
          option(value='R') R
          option(value='S') S
          option(value='T') T
          option(value='U') U
          option(value='V') V
          option(value='W') W
          option(value='X') X
          option(value='Y') Y
          option(value='Z') Z

    //- Tabla de ranking
    .table-wrapper
      table.ranking-table
        thead
          tr
            th
              span(data-sort-state='none') Pos.
              .sort-icon ↑
              .sort-icon ↓
              .sort-icon ↕
            th
              span(data-sort-state='none') Usuario
              .sort-icon ↑
              .sort-icon ↓
              .sort-icon ↕
            th
              span(data-sort-state='none') Capt.
              .sort-icon ↑
              .sort-icon ↓
              .sort-icon ↕
            th Esc.
            th
              span(data-sort-state='none') % Capt.
              .sort-icon ↑
              .sort-icon ↓
              .sort-icon ↕
            th Nivel
            th Fecha
            th Acciones

        tbody#rankingTableBody
          tr
            td(colspan='8').loading Cargando ranking...

    //- Paginación
    .ranking-pagination
      #pageInfo Página 1 de 1
      .pagination-controls
        button#prevBtn.pagination-btn(onclick='previousPage()' disabled) ‹ Anterior
        button#nextBtn.pagination-btn(onclick='nextPage()') Siguiente ›

block scripts
  script(src='/js/multiColumnSort.js')
  script(src='/js/ranking.js')
